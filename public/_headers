# Cloudflare Pages headers config.
# Forces the correct Content-Type for robots.txt and sitemap files so they
# are never served as HTML. Also adds long-lived caching for hashed assets.

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Caddyfile for yankvasya.dev
# Place this at the Caddy site root (e.g. /etc/caddy/Caddyfile) or reference
# it from your main Caddyfile. It enables compression + long-lived caching,
# which directly addresses the slow TTFB / render-blocking issues.

yankvasya.dev {
	# Serve the static Astro build from the snap site root.
	root * /var/snap/caddy/common/sites/yankvasya-landing

	# Enable gzip + brotli compression (Caddy does this by default, but
	# explicit is better for clarity).
	encode gzip zstd

	# ---- Caching headers ----
	# Hashed, immutable assets (Astro emits /_astro/*.hash.css|js|woff2).
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# robots.txt, sitemap, favicon — short cache so edits propagate quickly.
	@static path /robots.txt /sitemap-index.xml /sitemap-0.xml
	header @static Cache-Control "public, max-age=3600"

	# HTML documents — no-cache so Lighthouse/visitors always get fresh HTML,
	# but revalidate to avoid re-downloading unchanged bytes.
	@html path /
	header @html Cache-Control "no-cache"

	# ---- Security headers (also helps Best Practices) ----
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# SPA-style fallback: serve index.html for unknown paths (e.g. /robots.txt
	# previously returned the home page HTML — this is what caused the 18
	# robots.txt syntax errors). With a real public/robots.txt this is no
	# longer hit for robots.txt, but keep it for other deep links.
	try_files {path} /index.html

	# Static file server.
	file_server
}

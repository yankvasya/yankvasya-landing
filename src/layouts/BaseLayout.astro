---
import '../styles/global.css';
import { profile } from '../data/site';

// Self-hosted variable fonts (bundled by Astro/Vite at build time).
// Replaces the render-blocking Google Fonts <link> request.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';


interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.role} building fast, clean and maintainable web interfaces.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e0d" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://yankvasya.dev" />

    <title>{title}</title>

    <!-- Favicon (inline SVG terminal prompt) -->

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230a0e0d'/%3E%3Ctext x='50' y='68' font-size='52' text-anchor='middle' fill='%234ade80' font-family='monospace'%3E%3E_%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

---
import { profile } from '../data/site';

const links = [
  { label: 'Telegram', href: profile.contacts.telegram },
  { label: 'LinkedIn', href: profile.contacts.linkedin },
  { label: 'GitHub', href: profile.contacts.github },
  { label: 'Email', href: `mailto:${profile.contacts.email}` },
];
---

<section id="contact" class="section contact">
  <div class="container">
    <h2 class="section-head reveal">
      <span class="prompt">$</span>
      <span class="num">04.</span>
      contact
    </h2>

    <div class="contact-body reveal" data-delay="1">
      <h3 class="contact-title">Let's build something together.</h3>
      <p class="contact-text">
        I'm currently open to new opportunities and interesting projects.
        Feel free to reach out — I usually reply quickly.
      </p>

      <div class="contact-links">
        {
          links.map((l) => (
            <a
              class="contact-link mono"
              href={l.href}
              target={l.href.startsWith('mailto') ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <span class="prompt">./</span>{l.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-text mono">
      <span class="prompt">$</span> echo "© {new Date().getFullYear()} {profile.name}"
    </p>
    <p class="footer-text mono">
      <span class="prompt">$</span> built with Astro
    </p>
  </div>
</footer>

<style>
  .contact-body {
    max-width: 34rem;
  }
  .contact-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .contact-text {
    color: var(--text-dim);
    margin-bottom: 2rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 0.85rem;
    transition: all 0.25s var(--ease);
  }
  .contact-link .prompt {
    color: var(--accent);
  }
  .contact-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 2rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .footer-text {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .footer-text .prompt {
    color: var(--accent);
    margin-right: 0.35rem;
  }
</style>

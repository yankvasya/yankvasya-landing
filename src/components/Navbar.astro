---
import { profile } from '../data/site';

const links = [
  { href: '#about', label: 'about' },
  { href: '#experience', label: 'experience' },
  { href: '#projects', label: 'projects' },
  { href: '#contact', label: 'contact' },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="nav-logo mono" aria-label="Home — yankvasya">
      <span class="prompt">~/</span>{profile.handle}
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class="nav-link mono">
            <span class="prompt">./</span>{l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 14, 13, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 60px;
  }

  .nav-logo {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .nav-logo .prompt {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: 0.82rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .nav-link .prompt {
    color: var(--text-faint);
    transition: color 0.2s var(--ease);
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .nav-link:hover .prompt {
    color: var(--accent);
  }

  /* Tablet / small screens: tighten spacing */
  @media (max-width: 640px) {
    .nav-links {
      gap: 0.9rem;
    }
    .nav-link {
      font-size: 0.78rem;
    }
  }

  /* Mobile: allow the header to wrap onto two lines if the links
     don't fit next to the logo, so nothing overflows the screen */
  @media (max-width: 480px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
      row-gap: 0.4rem;
    }
    .nav-links {
      flex: 1 1 100%;
      justify-content: flex-start;
      gap: 0.85rem;
    }
    .nav-link .prompt {
      display: none;
    }
    .nav-link {
      font-size: 0.78rem;
    }
  }

  /* Very narrow screens: tighten further */
  @media (max-width: 360px) {
    .nav-logo {
      font-size: 0.85rem;
    }
    .nav-logo .prompt {
      display: none;
    }
    .nav-links {
      gap: 0.7rem;
    }
    .nav-link {
      font-size: 0.74rem;
    }
  }
</style>

---
import { profile } from '../data/site';

const socials = [
  { label: 'Telegram', href: profile.contacts.telegram, icon: 'tg' },
  { label: 'LinkedIn', href: profile.contacts.linkedin, icon: 'in' },
  { label: 'GitHub', href: profile.contacts.github, icon: 'gh' },
];
---

<section id="top" class="hero">
  <div class="container">
    <p class="hero-greeting mono reveal">
      <span class="prompt">$</span> whoami
    </p>

    <h1 class="hero-name reveal" data-delay="1">
      {profile.name}
    </h1>

    <p class="hero-role mono reveal" data-delay="2">
      <span class="prompt">></span>
      <span id="typed" class="typed"></span><span class="cursor">▊</span>
    </p>

    <p class="hero-tagline reveal" data-delay="3">
      {profile.tagline}
    </p>

    <div class="hero-meta mono reveal" data-delay="3">
      <span class="meta-item">
        <span class="meta-key">location</span>
        <span class="meta-val">{profile.location}</span>
      </span>
      <span class="meta-item">
        <span class="meta-key">status</span>
        <span class="meta-val status-open">open to work</span>
      </span>
    </div>

    <div class="hero-actions reveal" data-delay="4">
      <a class="btn btn-primary" href="#projects">
        <span class="prompt">./</span>view projects
      </a>
      <a class="btn btn-ghost" href="#contact">
        <span class="prompt">./</span>contact me
      </a>
    </div>

    <div class="hero-socials reveal" data-delay="4">
      {
        socials.map((s) => (
          <a
            class="social"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              {s.icon === 'tg' && (
                <path d="M21.9 4.3 18.6 19c-.2 1-.8 1.2-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-.9.5l.3-4.6L18 6.6c.4-.3-.1-.5-.6-.2L6.6 13.2l-4.5-1.4c-1-.3-1-1 .2-1.4L20.6 3c.8-.3 1.5.2 1.3 1.3z" />
              )}
              {s.icon === 'in' && (
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21H9z" />
              )}
              {s.icon === 'gh' && (
                <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z" />
              )}
            </svg>
            <span>{s.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const roles = [
    'Frontend Developer',
    'Vue / TypeScript',
    'UI Engineer',
    'Problem Solver',
  ];
  const el = document.getElementById('typed');
  if (el) {
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const current = roles[roleIndex];
      if (!deleting) {
        el.textContent = current.slice(0, ++charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(tick, 1800);
          return;
        }
        setTimeout(tick, 70);
      } else {
        el.textContent = current.slice(0, --charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 35);
      }
    }
    tick();
  }
</script>

<style>
  .hero {
    padding: clamp(4rem, 12vh, 7rem) 0 3rem;
  }

  .hero-greeting {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }
  .hero-greeting .prompt {
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .hero-name {
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero-role {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--accent);
    min-height: 1.6em;
  }
  .hero-role .prompt {
    color: var(--text-faint);
    margin-right: 0.5rem;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-tagline {
    margin-top: 1.5rem;
    max-width: 34rem;
    color: var(--text-dim);
    font-size: 1.05rem;
  }

  .hero-meta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.82rem;
  }
  .meta-item {
    display: inline-flex;
    gap: 0.5rem;
  }
  .meta-key {
    color: var(--text-faint);
  }
  .meta-val {
    color: var(--text-dim);
  }
  .status-open {
    color: var(--accent);
  }
  .status-open::before {
    content: '●';
    margin-right: 0.35rem;
    font-size: 0.7rem;
    vertical-align: middle;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.25s var(--ease);
  }
  .btn .prompt {
    color: inherit;
    opacity: 0.7;
  }
  .btn-primary {
    background: var(--accent);
    color: #06210f;
  }
  .btn-primary:hover {
    background: #a7f3c8;
    color: #06210f;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  .btn-ghost {
    border: 1px solid var(--border-strong);
    color: var(--text);
  }
  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .hero-socials {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .social svg {
    transition: transform 0.25s var(--ease);
  }
  .social:hover {
    color: var(--accent);
  }
  .social:hover svg {
    transform: translateY(-2px);
  }
</style>

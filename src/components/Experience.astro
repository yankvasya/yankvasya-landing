---
import { experience } from '../data/site';
---

<section id="experience" class="section">
  <div class="container">
    <h2 class="section-head reveal">
      <span class="prompt">$</span>
      <span class="num">02.</span>
      experience
    </h2>

    <div class="timeline">
      {
        experience.map((job, i) => (
          <article class="job reveal" data-delay={i % 2}>
            <div class="job-head">
              <h3 class="job-company">
                <span class="prompt">▸</span> {job.company}
              </h3>
              <span class="job-period mono">{job.period}</span>
            </div>
            <p class="job-role mono">{job.role}</p>

            <ul class="job-highlights">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>

            <div class="job-stack mono">
              {job.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .job {
    position: relative;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }
  .job::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .job-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .job-company {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }
  .job-company .prompt {
    color: var(--accent);
    margin-right: 0.35rem;
  }
  .job-period {
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .job-role {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--accent-dim);
  }

  .job-highlights {
    margin-top: 1rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .job-highlights li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .job-highlights li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .job-stack {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--text-dim);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
  }
</style>
